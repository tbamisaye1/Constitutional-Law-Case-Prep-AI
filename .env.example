# OpenRouter: https://openrouter.ai/keys
# OpenAI-compatible base URL; we point the LangChain OpenAI client here.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Start cheap / free-tier friendly; swap model ids as you experiment.
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Embeddings backend: openrouter (default) | local
# local needs: pip install sentence-transformers
EMBEDDINGS_BACKEND=openrouter
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Local paths for uploads + vector store (created on first ingest)
DATA_DIR=./data
