# OpenRouter: https://openrouter.ai/keys
# OpenAI-compatible base URL; we point the LangChain OpenAI client here.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI Responses API powers Ask AI Web mode when this key is present.
# OpenRouter remains the fallback and continues to power PDF embeddings.
OPENAI_API_KEY=
OPENAI_WEB_MODEL=gpt-5-mini

# Start cheap / free-tier friendly; swap model ids as you experiment.
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Embeddings backend: openrouter (default) | local
# local needs: pip install sentence-transformers
EMBEDDINGS_BACKEND=openrouter
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Local paths for uploads + vector store (created on first ingest)
DATA_DIR=./data

# Neon Postgres for notes / annotations / matters persistence.
# Easiest source: `vercel env pull .env.local` after adding the Neon
# integration to the case-law-agent-api project. Use the pooled URL (the host
# contains "-pooler"); the unpooled one runs out of connections on serverless.
# Leave empty to run browser-only, with sync switched off.
DATABASE_URL=

# Vercel Blob holds uploaded PDF bytes and the FAISS index zip.
# Also comes from `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=
